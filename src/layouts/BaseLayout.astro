---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = '技术爱好者',
  description = '记录技术实践、自动化工具与自建服务',
  lang = 'zh-CN',
} = Astro.props;

const pageTitle = title === '技术爱好者' ? title : `${title} · 技术爱好者`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">技术爱好者</a>
        <nav class="nav">
          <a href="/">首页</a>
          <a href="/blog/">博客</a>
          <a href="/cf-ips/">CF优选IP</a>
          <a href="/about/">关于</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} 技术爱好者</span>
        <span>记录技术实践、自动化工具与自建服务</span>
      </div>
    </footer>
  </body>
</html>
