---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/cf-ips.json';

interface IpEntry {
  ip: string;
  colo?: string;
  isp?: string;
  port?: string;
  tag?: string;
}

const groups = data.groups as Record<string, IpEntry[]>;

const sections = [
  { key: 'telecom', title: '电信优选', desc: '适合电信宽带' },
  { key: 'unicom', title: '联通优选', desc: '适合联通宽带' },
  { key: 'mobile', title: '移动优选', desc: '适合移动宽带' },
  { key: 'ipv4', title: 'IPv4 综合', desc: '多源聚合，每 2 小时更新' },
  { key: 'ipv6', title: 'IPv6 综合', desc: '多源聚合，每 2 小时更新' },
];

const updatedAt = new Date(data.updated_at);
const fmtTime = updatedAt.toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });
---

<BaseLayout
  title="CF 优选 IP"
  description="Cloudflare 优选 IP 定时更新，一键复制，支持延迟测试"
>
  <section class="hero">
    <h1>CF 优选 IP</h1>
    <p class="bio">
      每 6 小时自动从公开数据源抓取更新。
      数据更新于 <time>{fmtTime}</time>（北京时间）。
    </p>
    <p class="bio">
      点「测试延迟」会从你的浏览器直接向各 IP 发起连接，测出你当前网络的真实延迟，
      并按延迟从低到高自动排序。
    </p>
  </section>

  {
    sections.map((sec) => (
      <section class="ip-section">
        <div class="ip-section-head">
          <h2 class="section-title">
            {sec.title}
            <span class="count">{groups[sec.key]?.length ?? 0} 个</span>
          </h2>
          <div class="head-actions">
            <button
              class="test-btn"
              data-test={sec.key}
              type="button"
            >
              测试延迟
            </button>
            <button
              class="copy-all"
              data-copy-all={sec.key}
              type="button"
            >
              复制全部
            </button>
          </div>
        </div>
        <p class="section-desc">{sec.desc}</p>
        <ul class="ip-list" id={`list-${sec.key}`}>
          {(groups[sec.key] ?? []).map((entry) => (
            <li class="ip-row">
              <code class="ip">{entry.ip}</code>
              <span class="latency" hidden></span>
              {entry.colo && <span class="tag">{entry.colo}</span>}
              {entry.tag && <span class="tag">{entry.tag}</span>}
              <button
                class="copy-btn"
                data-copy={entry.ip}
                type="button"
                aria-label={`复制 ${entry.ip}`}
              >
                复制
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <h2 class="section-title">使用说明</h2>
  <ul class="about-list">
    <li>按你的宽带运营商选择对应分组，延迟通常最低。</li>
    <li>点「测试延迟」从你当前网络实测各 IP 延迟，自动按最快排序，再「复制全部」拿走的就是最优顺序。</li>
    <li>把 IP 填到代理客户端的 Cloudflare 节点地址栏（只改地址，SNI/Host 保持原域名）。</li>
    <li>优选 IP 会随网络状况变化，定期回来复制最新的即可。</li>
  </ul>

  <h2 class="section-title">数据来源</h2>
  <ul class="about-list">
    {
      (data.sources as { name: string; url: string }[]).map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener">{s.name}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<script>
  // 从浏览器直接向 IP 发起 HTTPS 连接，测量握手耗时。
  // 直连 IP 证书必然校验失败，但失败前已完成 TCP + TLS 握手，
  // 耗时与网络 RTT 正相关，足以用于排序筛选。
  async function measureLatency(ip: string): Promise<number | null> {
    const host = ip.includes(':') ? `[${ip}]` : ip;
    const url = `https://${host}/`;
    const TIMEOUT = 4000;
    const start = performance.now();
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), TIMEOUT);
      await fetch(url, {
        mode: 'no-cors',
        cache: 'no-store',
        signal: ctrl.signal,
      }).catch(() => {});
      clearTimeout(timer);
    } catch {
      // ignore
    }
    const elapsed = performance.now() - start;
    return elapsed >= TIMEOUT ? null : Math.round(elapsed);
  }

  async function runPool<T>(
    items: T[],
    limit: number,
    fn: (item: T) => Promise<void>
  ): Promise<void> {
    let i = 0;
    async function worker() {
      while (i < items.length) {
        const idx = i++;
        await fn(items[idx]);
      }
    }
    await Promise.all(
      Array.from({ length: Math.min(limit, items.length) }, worker)
    );
  }

  function latencyClass(ms: number): string {
    if (ms < 150) return 'fast';
    if (ms < 400) return 'mid';
    return 'slow';
  }

  // 复制
  function copyText(text: string, btn: HTMLButtonElement) {
    navigator.clipboard
      .writeText(text)
      .then(() => {
        const old = btn.textContent;
        btn.textContent = '已复制';
        btn.disabled = true;
        setTimeout(() => {
          btn.textContent = old;
          btn.disabled = false;
        }, 1200);
      })
      .catch(() => {
        btn.textContent = '复制失败';
      });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      copyText(btn.dataset.copy || '', btn);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy-all]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.copyAll || '';
      const list = document.getElementById(`list-${key}`);
      if (!list) return;
      const ips = Array.from(list.querySelectorAll<HTMLElement>('[data-copy]'))
        .map((el) => el.dataset.copy || '')
        .filter(Boolean);
      copyText(ips.join('\n'), btn);
    });
  });

  // 延迟测试
  document.querySelectorAll<HTMLButtonElement>('[data-test]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const key = btn.dataset.test || '';
      const list = document.getElementById(`list-${key}`);
      if (!list) return;
      const rows = Array.from(list.querySelectorAll<HTMLElement>('.ip-row'));
      btn.disabled = true;
      let done = 0;
      const total = rows.length;
      const updateLabel = () => {
        btn.textContent = `测试中 ${done}/${total}`;
      };
      updateLabel();

      await runPool(rows, 6, async (row) => {
        const copyEl = row.querySelector<HTMLElement>('[data-copy]');
        const ip = copyEl?.dataset.copy || '';
        const ms = await measureLatency(ip);
        row.dataset.latency = ms === null ? 'timeout' : String(ms);
        const badge = row.querySelector<HTMLElement>('.latency');
        if (badge) {
          if (ms === null) {
            badge.textContent = '超时';
            badge.className = 'latency timeout';
          } else {
            badge.textContent = `${ms}ms`;
            badge.className = `latency ${latencyClass(ms)}`;
          }
          badge.hidden = false;
        }
        done++;
        updateLabel();
      });

      // 按延迟升序排列，超时的沉底
      rows
        .sort((a, b) => {
          const la = a.dataset.latency || 'timeout';
          const lb = b.dataset.latency || 'timeout';
          if (la === 'timeout' && lb === 'timeout') return 0;
          if (la === 'timeout') return 1;
          if (lb === 'timeout') return -1;
          return Number(la) - Number(lb);
        })
        .forEach((r) => list.appendChild(r));

      btn.textContent = '重新测试';
      btn.disabled = false;
    });
  });
</script>

<style>
  .ip-section {
    margin-bottom: 2rem;
  }

  .ip-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ip-section-head .section-title {
    margin-bottom: 0.25rem;
  }

  .head-actions {
    display: flex;
    gap: 0.5rem;
  }

  .count {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.5rem;
  }

  .section-desc {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .copy-all,
  .copy-btn,
  .test-btn {
    font: inherit;
    font-size: 0.82rem;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .copy-all:hover,
  .copy-btn:hover,
  .test-btn:hover {
    border-color: var(--accent);
  }

  .copy-all:disabled,
  .copy-btn:disabled,
  .test-btn:disabled {
    color: var(--muted);
    cursor: default;
  }

  .ip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .ip-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .ip-row:last-child {
    border-bottom: none;
  }

  .ip-row:nth-child(even) {
    background: var(--bg-soft);
  }

  .ip {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.92rem;
    background: none;
    padding: 0;
  }

  .latency {
    font-size: 0.78rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .latency.fast {
    color: #15803d;
    border-color: #bbf7d0;
    background: #f0fdf4;
  }

  .latency.mid {
    color: #b45309;
    border-color: #fde68a;
    background: #fffbeb;
  }

  .latency.slow {
    color: #b91c1c;
    border-color: #fecaca;
    background: #fef2f2;
  }

  .latency.timeout {
    color: var(--muted);
  }

  .ip-row .tag {
    margin-right: 0;
  }

  .ip-row .copy-btn {
    margin-left: auto;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
